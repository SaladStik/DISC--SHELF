{
  "file": "index.html",
  "title": "DISC//SHELF",
  "description": "Your Spotify library as a wall of jewel cases. The robot fetches whatever your PC is playing and the room moves to the real bass.",
  "type": "web",
  "tags": ["Music"],
  "general": {
    "supportsaudioprocessing": true,
    "properties": {
      "signinhelp": { "order": -3, "text": "<b>Sign in to Spotify</b> (optional: without it you get a demo library)<br>1. Open <a href='https://developer.spotify.com/dashboard'>developer.spotify.com/dashboard</a>, log in and press <i>Create app</i>. Any name works.<br>2. As Redirect URI enter <b>https://diskshelf.saladsync.ca/</b>, tick <i>Web API</i>, and save.<br>3. Open the app's <i>Settings</i>, copy its <b>Client ID</b> and paste it below.<br>4. A blue sign-in button appears on the wallpaper. Click it and approve in your browser.<br>5. The page then shows a code. Copy it and paste it into <b>Spotify sign-in code</b> below.<br>Playing discs needs Spotify Premium and Spotify open on one of your devices.", "type": "text" },
      "clientid": { "order": -2, "text": "Spotify Client ID", "type": "textinput", "value": "" },
      "code": { "order": -1, "text": "Spotify sign-in code", "type": "textinput", "value": "" },
      "room": {
        "order": 1,
        "text": "Room",
        "type": "combo",
        "value": "records",
        "options": [
          { "label": "Record store", "value": "records" },
          { "label": "90s bedroom", "value": "bedroom" },
          { "label": "Arcade", "value": "arcade" },
          { "label": "Vapor lounge", "value": "vapor" }
        ]
      },
      "format": {
        "order": 2,
        "text": "Format",
        "type": "combo",
        "value": "cd",
        "options": [
          { "label": "CD", "value": "cd" },
          { "label": "Vinyl", "value": "vinyl" },
          { "label": "Tape", "value": "tape" }
        ]
      },
      "bass": { "order": 3, "text": "Bass reaction", "type": "slider", "value": 1, "min": 0, "max": 2, "fraction": true, "step": 0.1 },
      "volume": { "order": 4, "text": "Spotify volume", "type": "slider", "value": 60, "min": 0, "max": 100 },
      "nowplaying": { "order": 5, "text": "Show now playing", "type": "bool", "value": true },
      "mouse": { "order": 6, "text": "React to the mouse", "type": "bool", "value": true },
      "taskbar": { "order": 7, "text": "Taskbar height", "type": "slider", "value": 48, "min": 0, "max": 120 },
      "diag": { "order": 9, "text": "Show diagnostics", "type": "bool", "value": false },
      "redirect": { "order": 8, "text": "Spotify Redirect URI (only if you host the site yourself)", "type": "textinput", "value": "https://diskshelf.saladsync.ca/" }
    }
  }
}
